{
  "name": "backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && node add-js-extensions.js && mkdir -p dist/storage/migrations && cp src/storage/migrations/*.sql dist/storage/migrations/",
    "start": "node dist/index.js",
    "lint": "eslint src --ext .ts",
    "test": "vitest run",
    "db:push": "tsx src/storage/migrate.ts"
  },
  "dependencies": {
    "@ai-conv/types": "*",
    "@fastify/cors": "^11.0.3",
    "@fastify/static": "^10.1.3",
    "@fastify/websocket": "^11.0.3",
    "@socket.io/redis-adapter": "^8.3.0",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.12.7",
    "ioredis": "^5.4.1",
    "js-yaml": "^4.1.0",
    "jsonwebtoken": "^9.0.3",
    "ollama": "^0.5.11",
    "socket.io": "^4.7.5",
    "socket.io-client": "^4.8.3",
    "undici": "^8.10.2",
    "uuid": "^14.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.10",
    "@types/ioredis": "^5.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.12.7",
    "@types/uuid": "^9.0.8",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "eslint": "^8.57.1",
    "tsc-alias": "^1.9.2",
    "tsx": "^4.7.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
