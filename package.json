{
  "name": "ai-conv",
  "version": "0.2.0",
  "private": true,
  "workspaces": [
    "backend",
    "frontend",
    "packages/types"
  ],
  "scripts": {
    "setup": "node scripts/generate-jwt-secret.mjs",
    "dev": "npm run setup && concurrently 'npm:dev:*'",
    "dev:backend": "npm run dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:types": "npm run dev --workspace=packages/types",
    "serve": "bash scripts/rebuild-restart.sh",
    "build": "npm run build --workspaces",
    "lint": "npm run lint --workspaces",
    "db:push": "npm run db:push --workspace=backend",
    "tauri:build": "bash src-tauri/build-tauri.sh",
    "tauri:dev": "cargo run --release --manifest-path src-tauri/Cargo.toml"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "esbuild": "^0.28.2"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true
  },
  "description": "A real-time desktop (Tauri) messenger where **you create your own AI personas** — powered by local LLMs via Ollama. No hard-coded personas, no hard-coded models.",
  "main": "index.js",
  "keywords": [],
  "type": "commonjs",
  "overrides": {
    "@fastify/static": {
      "glob": "14.0.3"
    }
  }
}
