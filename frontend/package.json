{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "description": "AI Conv - Multi-Persona Messenger",
  "author": "AI Conv Team <team@aiconv.local>",
  "homepage": "https://github.com/aiconv/ai-conv",
  "scripts": {
    "dev": "vite --host",
    "app": "electron .",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint src --ext .ts,.tsx",
    "test": "vitest run src",
    "package": "tsc && vite build && npx electron-rebuild && node scripts/bundle-backend.cjs && electron-builder --linux --dir && node scripts/post-package.cjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@ai-conv/types": "*",
    "clsx": "^2.1.0",
    "electron-updater": "^6.8.9",
    "fastify": "5.12.1",
    "lucide-react": "^0.363.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "socket.io-client": "^4.8.3",
    "tailwind-merge": "^2.2.1",
    "uuid": "14.0.2",
    "zustand": "^4.5.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.19",
    "electron": "43.4.1",
    "electron-builder": "^26.15.3",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.3",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "build": {
    "appId": "com.aiconv.app",
    "productName": "AI Conv",
    "executableName": "ai-conv",
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "extraResources": [
      {
        "from": "dist",
        "to": "frontend-dist",
        "filter": ["**/*"]
      },
      {
        "from": "resources/backend",
        "to": "backend",
        "filter": [
          "**/*",
          "!**/node_modules/.cache/**"
        ]
      }
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Network;Chat",
      "icon": "build/icons/"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon.png"
    }
  }
}
