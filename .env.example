# Backend
PORT=3001
NODE_ENV=development
OLLAMA_HOST=http://ollama:11434
CORS_ORIGIN=http://localhost:5173
DATABASE_PATH=/data/ai-conv.db
JWT_SECRET=your-secret-key-change-in-production
REDIS_URL=redis://localhost:6379
# Comma-separated CIDRs treated as local clients (loopback is always local).
# Only needed when a container port maps the browser's source address to the
# Docker bridge gateway; compose sets 172.16.0.0/12 for that reason.
LOCAL_CLIENT_CIDRS=

# Frontend
VITE_API_URL=http://localhost:3001
VITE_WS_URL=http://localhost:3001
